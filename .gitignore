# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan
tfplan
# Variable files may hold secrets (emails, bucket names): never commit one. A template named
# *.tfvars.example with placeholders only may be committed.
*.tfvars
*.tfvars.json
!*.tfvars.example
# Keep .terraform.lock.hcl committed so provider versions stay pinned.

# Lambda build artifacts
build/
*.zip
out.json

# Secrets and credentials
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials
*credentials*
.aws/
.ssh/
id_rsa*
id_ed25519*
*.ppk

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code local settings and memory (the whole folder stays local)
.claude/

# Backend config holds the state bucket name (copy from backend.hcl.example)
backend.hcl

# Local to-do list, not published (same as secure-serverless-api-aws)
TODO.md

# Personal permission-set policy (copy of another project's statements); keep local only
terraform/iam/combined-permission-set-policy.json

# Local runbook for making a repository public; keep it out of the repository
RUNBOOK_PUBLIC_RELEASE.md

# Logs, scratch files and backups can hold order data, addresses or ARNs
*.log
logs/
*.bak
*.tmp
*.orig
scratch/
tmp/

# Tool credential files and data dumps that are easy to commit by accident
.npmrc
.netrc
.docker/
.envrc
.gnupg/
secrets.*
*.secret
*.dump
backup*.sql
